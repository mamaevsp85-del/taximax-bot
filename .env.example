# Токен MAX-бота (Платформа MAX -> Чат-боты -> Настройки)
MAX_BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_СЮДА
# Базовый URL API. ВАЖНО: platform-api2.max.ru из документации НЕ резолвится
# у многих провайдеров — рабочий домен platform-api.max.ru
MAX_BASE_URL=https://platform-api.max.ru

# Админы (MAX user_id через запятую). Главный админ и создатель: 14566736
ADMIN_USER_IDS=14566736
# Ссылка на аккаунт админа в MAX для кнопки «Стать водителем»
ADMIN_MAX_LINK=https://max.ru/

# Контакт поддержки
SUPPORT_CONTACT=developer@example.com

# URL внешней Mini-App (для кнопки «🚀 Открыть Mini-App» в боте).
# Например: https://pearl-aspen-b471789c.tunnl.gg  или адрес Railway/Render.
# По умолчанию (если не задано) — http://127.0.0.1:8080 для локального запуска.
MINI_APP_URL=http://127.0.0.1:8080

# API ключи (задайте СВОИ значения — в кабинете Яндекс.Геокодера)
YANDEX_API_KEY=ВСТАВЬТЕ_КЛЮЧ_ЯНДЕКСА
OPENROUTESERVICE_KEY=

# Ключ для приватных REST-эндпоинтов api_server.py (заголовок X-API-Key или ?api_key=)
# Сгенерируйте любой длинный случайный набор символов.
API_KEY=ВСТАВЬТЕ_СЛУЧАЙНЫЙ_КЛЮЧ

# Опциональный секрет webhook (заголовок X-Webhook-Secret или ?secret=)
WEBHOOK_SECRET=

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
